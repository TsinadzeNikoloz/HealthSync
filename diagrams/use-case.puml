@startuml HealthSync Use Case Diagram

skinparam actorStyle awesome
skinparam packageStyle rectangle
skinparam usecaseBackgroundColor #F8FAFC
skinparam usecaseBorderColor #4F46E5
skinparam actorBackgroundColor #4F46E5
skinparam rectangleBackgroundColor #FFFFFF
skinparam rectangleBorderColor #CBD5E1

left to right direction

actor "Guest\n(Unauthenticated)" as guest
actor "Patient" as patient
actor "Doctor" as doctor
actor "Admin" as admin

rectangle "HealthSync System" {

  ' === Authentication ===
  package "Authentication" {
    usecase "Sign Up" as UC_SIGNUP
    usecase "Log In" as UC_LOGIN
    usecase "Log Out" as UC_LOGOUT
    usecase "Forgot Password" as UC_FORGOT_PW
    usecase "Reset Password" as UC_RESET_PW
    usecase "Update Password" as UC_UPDATE_PW
    usecase "Update Profile" as UC_UPDATE_PROFILE
    usecase "Upload Photo" as UC_UPLOAD_PHOTO
    usecase "Delete Account" as UC_DELETE_ACCOUNT
  }

  ' === Services ===
  package "Services" {
    usecase "Browse Services" as UC_BROWSE_SVC
    usecase "View Service Details" as UC_VIEW_SVC
    usecase "Filter/Sort Services" as UC_FILTER_SVC
    usecase "View Service Statistics" as UC_VIEW_STATS
    usecase "Create Service" as UC_CREATE_SVC
    usecase "Update Service" as UC_UPDATE_SVC
    usecase "Delete Service" as UC_DELETE_SVC
  }

  ' === Appointments ===
  package "Appointments" {
    usecase "Book Appointment\n(Stripe Checkout)" as UC_BOOK_APT
    usecase "Redirect to Login" as UC_REDIRECT_LOGIN
    usecase "View My Appointments" as UC_VIEW_MY_APT
    usecase "View All Appointments" as UC_VIEW_ALL_APT
    usecase "Create Appointment" as UC_CREATE_APT
    usecase "Confirm Appointment" as UC_CONFIRM_APT
    usecase "Cancel Appointment" as UC_CANCEL_APT
    usecase "Complete Appointment" as UC_COMPLETE_APT
    usecase "Update Appointment" as UC_UPDATE_APT
    usecase "Delete Appointment" as UC_DELETE_APT
  }

  ' === Medical Records ===
  package "Medical Records" {
    usecase "View Medical History" as UC_VIEW_MY_REC
    usecase "View All Records" as UC_VIEW_ALL_REC
    usecase "View Patient Records" as UC_VIEW_PAT_REC
    usecase "View Record by\nAppointment" as UC_VIEW_APT_REC
    usecase "Create Medical Record" as UC_CREATE_REC
    usecase "Update Medical Record" as UC_UPDATE_REC
    usecase "Delete Medical Record" as UC_DELETE_REC
  }

  ' === Reviews ===
  package "Reviews" {
    usecase "View Reviews" as UC_VIEW_REV
    usecase "Write Review" as UC_WRITE_REV
    usecase "Update Review" as UC_UPDATE_REV
    usecase "Delete Review" as UC_DELETE_REV
  }

  ' === User Management ===
  package "User Management" {
    usecase "View Dashboard\nStatistics" as UC_DASHBOARD
    usecase "View All Users" as UC_VIEW_USERS
    usecase "Create User" as UC_CREATE_USER
    usecase "Update User" as UC_UPDATE_USER
    usecase "Delete User" as UC_DELETE_USER
  }
}

' ========== GUEST associations ==========
guest --> UC_SIGNUP
guest --> UC_LOGIN
guest --> UC_FORGOT_PW
guest --> UC_BROWSE_SVC
guest --> UC_VIEW_SVC
guest --> UC_FILTER_SVC
guest --> UC_VIEW_STATS
guest --> UC_VIEW_REV
guest --> UC_BOOK_APT

' ========== PATIENT associations ==========
patient --> UC_SIGNUP
patient --> UC_LOGIN
patient --> UC_LOGOUT
patient --> UC_FORGOT_PW
patient --> UC_UPDATE_PW
patient --> UC_UPDATE_PROFILE
patient --> UC_DELETE_ACCOUNT
patient --> UC_BROWSE_SVC
patient --> UC_VIEW_SVC
patient --> UC_FILTER_SVC
patient --> UC_BOOK_APT
patient --> UC_VIEW_MY_APT
patient --> UC_VIEW_MY_REC
patient --> UC_VIEW_REV
patient --> UC_WRITE_REV
patient --> UC_UPDATE_REV
patient --> UC_DELETE_REV

' ========== DOCTOR associations ==========
doctor --> UC_SIGNUP
doctor --> UC_LOGIN
doctor --> UC_LOGOUT
doctor --> UC_FORGOT_PW
doctor --> UC_UPDATE_PW
doctor --> UC_UPDATE_PROFILE
doctor --> UC_DELETE_ACCOUNT
doctor --> UC_BROWSE_SVC
doctor --> UC_VIEW_SVC
doctor --> UC_FILTER_SVC
doctor --> UC_VIEW_ALL_APT
doctor --> UC_CREATE_APT
doctor --> UC_CONFIRM_APT
doctor --> UC_CANCEL_APT
doctor --> UC_COMPLETE_APT
doctor --> UC_DELETE_APT
doctor --> UC_VIEW_ALL_REC
doctor --> UC_VIEW_PAT_REC
doctor --> UC_VIEW_APT_REC
doctor --> UC_CREATE_REC
doctor --> UC_UPDATE_REC
doctor --> UC_VIEW_REV

' ========== ADMIN associations ==========
admin --> UC_LOGIN
admin --> UC_LOGOUT
admin --> UC_FORGOT_PW
admin --> UC_UPDATE_PW
admin --> UC_UPDATE_PROFILE
admin --> UC_DELETE_ACCOUNT
admin --> UC_BROWSE_SVC
admin --> UC_VIEW_SVC
admin --> UC_FILTER_SVC
admin --> UC_CREATE_SVC
admin --> UC_UPDATE_SVC
admin --> UC_DELETE_SVC
admin --> UC_VIEW_ALL_APT
admin --> UC_CREATE_APT
admin --> UC_UPDATE_APT
admin --> UC_DELETE_APT
admin --> UC_VIEW_ALL_REC
admin --> UC_VIEW_PAT_REC
admin --> UC_VIEW_APT_REC
admin --> UC_CREATE_REC
admin --> UC_UPDATE_REC
admin --> UC_DELETE_REC
admin --> UC_VIEW_REV
admin --> UC_UPDATE_REV
admin --> UC_DELETE_REV
admin --> UC_DASHBOARD
admin --> UC_VIEW_USERS
admin --> UC_CREATE_USER
admin --> UC_UPDATE_USER
admin --> UC_DELETE_USER

' ========== Includes / Extends ==========
UC_FORGOT_PW ..> UC_RESET_PW : <<include>>
UC_UPDATE_PROFILE ..> UC_UPLOAD_PHOTO : <<extend>>
UC_BOOK_APT ..> UC_REDIRECT_LOGIN : <<extend>>
UC_CONFIRM_APT ..> UC_VIEW_ALL_APT : <<include>>
UC_CANCEL_APT ..> UC_VIEW_ALL_APT : <<include>>
UC_COMPLETE_APT ..> UC_VIEW_ALL_APT : <<include>>

note right of UC_REDIRECT_LOGIN
  Unauthenticated users are
  redirected to login when
  attempting to book
end note

@enduml
